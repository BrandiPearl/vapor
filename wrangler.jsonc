{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vapor",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by the cache/revalidation handler.
      // "service" must stay equal to "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vapor"
    }
  ],
  // No incremental-cache binding: open-next.config.ts uses the read-only
  // static-assets cache so the deploy needs no R2 bucket.
  "images": {
    // Powers next/image optimisation. If the account has no Images
    // entitlement, drop this block: images are then served unoptimised.
    "binding": "IMAGES"
  }
}
